# Discord: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Test server ID. When set, `pnpm deploy-commands` registers commands there instantly instead of globally.
DISCORD_GUILD_ID=
# Set to true only after enabling Server Members and Message Content under Bot → Privileged Gateway Intents.
# Needed by welcome, logs, antiraid, invites and counting.
DISCORD_PRIVILEGED_INTENTS=false

# Database: these values match compose.yaml for local development.
DATABASE_URL=postgres://roboteco:roboteco@localhost:5432/roboteco

# Object storage (Garage locally). Development keys only; prepare Garage with `pnpm storage:init`.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GKe0eaf809415eba6c4491e65b
S3_SECRET_ACCESS_KEY=f35c5ac8cf98fe2bcf4605b8b776d1635f2e5b7e9adf815424e291efcde6b3be
S3_BUCKET=roboteco

# Optional. Leave these commented out to use the defaults: an empty value is not the same as unset.
# NODE_ENV=development            # development | production | test
# LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
# SENTRY_DSN=                     # error reporting, off when empty
# HEALTH_PORT=3000                # serves GET /health when set
# GUILD_DATA_RETENTION_DAYS=30    # days to keep a server's data after the bot leaves it

# Safety scanning (/safety). Each check is optional; leave a key unset to skip that check.
# PHISHING_LIST_URLS=https://raw.githubusercontent.com/Discord-AntiScam/scam-links/main/list.txt  # comma-separated; empty disables
# CLAMAV_HOST=localhost           # clamd; start it with COMPOSE_PROFILES=clamav (use "clamav" in production)
# CLAMAV_PORT=3310
# SAFE_BROWSING_API_KEY=          # Google Safe Browsing Lookup API v4 (free for non-commercial use)
# ABUSECH_AUTH_KEY=               # abuse.ch Auth-Key, enables URLhaus and MalwareBazaar
# VIRUSTOTAL_API_KEY=             # only looks up existing reports; files are never uploaded
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# VIRUSTOTAL_REQUESTS_PER_DAY=500
# VIRUSTOTAL_MIN_DETECTIONS=3     # engines that must agree before a result counts
# SAFETY_MAX_FILE_MB=25           # larger attachments are not downloaded

# Docker Compose (compose.yaml for development, compose.prod.yaml for production)
# POSTGRES_USER=roboteco
# POSTGRES_DB=roboteco
# POSTGRES_PORT=5432
# GARAGE_S3_PORT=3900
# COMPOSE_PROFILES=clamav
# Required in production. Generate each with: openssl rand -hex 32
# POSTGRES_PASSWORD=
# GARAGE_RPC_SECRET=
# HEALTH_PUBLISH_PORT=3000
# ROBOTECO_VERSION=latest
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14
